// СМЕТА PRO — схема базы данных
// Деньги: Decimal(14,2). Количества: Decimal(14,4).
// Все пользовательские сущности содержат userId — сервер фильтрует каждый запрос по владельцу.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  tgId              BigInt    @unique
  firstName         String?
  username          String?
  companyName       String?
  contacts          String?
  designPrices      Json?
  aiEnabled         Boolean   @default(false)
  theme             String    @default("steel")
  themeChosen       Boolean   @default(false)
  trialEndsAt       DateTime
  subscriptionUntil DateTime?
  subNotice3At      DateTime? // когда отправлено «подписка заканчивается через 3 дня»
  subNoticeEndAt    DateTime? // когда отправлено «подписка закончилась»
  logoFile          String? // логотип для документов (файл в PHOTO_DIR/brand)
  signFile          String? // подпись/печать для документов
  weeklyDigest      Boolean   @default(true)
  docStyle          String    @default("classic") // classic (таблица с рамками) | modern
  lastDigestAt      DateTime?
  referredById      String? // кто пригласил
  referralRewardedAt DateTime? // когда пригласившему начислен бонусный месяц
  createdAt         DateTime  @default(now())

  priceLists PriceList[]
  items      CatalogItem[]
  estimates  Estimate[]
  projects   Project[]
  financeOps FinanceOp[]
  notes      Note[]
  payments   Payment[]
  audit      AuditLog[]
  photos     Photo[]
  workLogs   WorkLog[]
  reminders  Reminder[]
  addressBook Contact[]
  aiSessions AiSession[]
  workActs   WorkAct[]
  designs    Design[]
}

// Проект ИИ-проектировщика (навес и др.): параметры модели, из которых строятся чертежи, 3D и спецификация
model Design {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String    @default("canopy")
  title     String
  params    Json
  shareToken String?
  sharedAt   DateTime?
  viewedAt   DateTime?
  estimateId String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, deletedAt])
  @@index([shareToken])
  @@index([estimateId])
}

// Акт выполненных работ (в т.ч. промежуточный): снимок выполненных объёмов на дату
model WorkAct {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  number     Int
  date       DateTime
  periodFrom DateTime?
  items      Json // [{ key, name, unit, qty, unitPrice, amount, category }]
  subtotal   Decimal  @db.Decimal(14, 2) // по позициям
  total      Decimal  @db.Decimal(14, 2) // с накладными, скидкой, налогом пропорционально
  deletedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([estimateId])
}

// Напоминание: бот присылает сообщение в заданное время
model Reminder {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  text       String
  remindAt   DateTime // следующий момент отправки (UTC)
  repeat     String    @default("none") // none | daily | weekly | monthly
  active     Boolean   @default(true)
  lastSentAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([active, remindAt])
  @@index([userId])
}

// Записная книжка: заказчики, техника, поставщики, рабочие
model Contact {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name      String
  phone     String?
  category  String    @default("customer") // customer | equipment | supplier | worker | other
  note      String?
  date      DateTime // дата записи (по ней группировка)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, date])
}

// Диалог с ИИ-сметчиком
model AiSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Json     // [{role, content}]
  draft      Json?    // последний черновик сметы
  estimateId String?
  status     String   @default("active") // active | done
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, status])
}

// Фото объекта, привязанное к дню календаря. Файлы лежат на диске (PHOTO_DIR), в БД — метаданные.
model Photo {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  date      DateTime // день календаря (UTC-полночь)
  caption   String?
  file      String
  thumb     String
  size      Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, date])
}

// Запись журнала работ за день
model WorkLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  date      DateTime
  text      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, date])
}

model PriceList {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())
  items     CatalogItem[]

  @@index([userId])
}

model CatalogItem {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceListId    String
  priceList      PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  name           String
  type           String // work | material | equipment | service | other
  category       String
  unit           String
  price          Decimal        @db.Decimal(14, 2) // цена заказчику
  costPrice      Decimal?       @db.Decimal(14, 2) // закупочная / себестоимость
  description    String?
  notes          String?
  params         Json?
  active         Boolean        @default(true)
  priceUpdatedAt DateTime       @default(now())
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  history        PriceHistory[]

  @@index([userId, priceListId])
}

model PriceHistory {
  id        String      @id @default(cuid())
  itemId    String
  item      CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  price     Decimal     @db.Decimal(14, 2)
  costPrice Decimal?    @db.Decimal(14, 2)
  changedAt DateTime    @default(now())

  @@index([itemId])
}

model Estimate {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title          String
  customer       String?
  address        String?
  date           DateTime       @default(now())
  status         String         @default("draft") // draft | sent | approved | rejected | archived
  isTemplate     Boolean        @default(false)
  discountPct    Decimal        @default(0) @db.Decimal(6, 2)
  markupPct      Decimal        @default(0) @db.Decimal(6, 2)
  taxPct         Decimal        @default(0) @db.Decimal(6, 2)
  lossReservePct Decimal        @default(0) @db.Decimal(6, 2)
  delivery       Decimal        @default(0) @db.Decimal(14, 2)
  extraCosts     Decimal        @default(0) @db.Decimal(14, 2)
  roundAdjust    Decimal        @default(0) @db.Decimal(14, 2) // округление итога (± к сумме после налога)
  notes          String?
  source         String         @default("manual") // manual | ai
  paymentTerms   String?
  validDays      Int            @default(14)
  customerDetails String? // паспорт / реквизиты заказчика для договора
  workStart      DateTime?
  workEnd        DateTime?
  warrantyMonths Int            @default(12)
  shareToken     String? // ссылка для заказчика (случайные 18 байт; поиск по индексу)
  sharedAt       DateTime?
  viewedAt       DateTime?
  approvedAt     DateTime?
  customerComment String?
  sectionCoefs   Json? // { "Название раздела": 1.15 }
  paySchedule    Json? // [{ title, pct }]
  purchased      Json? // ключи материалов, отмеченных как купленные
  acts           WorkAct[]
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lines          EstimateLine[]

  @@index([shareToken])
  @@index([userId, deletedAt])
}

model EstimateLine {
  id            String   @id @default(cuid())
  estimateId    String
  estimate      Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  position      Int
  category      String?
  name          String
  type          String   @default("work")
  unit          String
  qty           Decimal  @db.Decimal(14, 4)
  price         Decimal  @db.Decimal(14, 2) // скопирована из справочника на момент добавления
  costPrice     Decimal? @db.Decimal(14, 2)
  matPrice      Decimal? @db.Decimal(14, 2) // цена материала за единицу в строке работы
  coef          Decimal  @default(1) @db.Decimal(8, 4)
  composition   String? // «в составе»: по строке на пункт
  catalogItemId String?
  note          String?
  unconfirmed   Boolean  @default(false) // для черновиков ИИ: позиция требует уточнения

  @@index([estimateId])
}

model Project {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  customer       String?
  address        String?
  status         String     @default("draft") // draft | estimated | negotiation | in_progress | paused | done | archived
  startDate      DateTime?
  endDate        DateTime?
  contractAmount Decimal    @default(0) @db.Decimal(14, 2)
  completionPct  Decimal    @default(0) @db.Decimal(5, 2)
  budget         Json? // ручные плановые бюджеты по категориям { materials, equipment, labor, other }
  notes          String?
  closedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  estimates      Estimate[]
  financeOps     FinanceOp[]
  projectNotes   Note[]
  photos         Photo[]
  workLogs       WorkLog[]
  reminders      Reminder[]
  contacts       Contact[]

  @@index([userId, deletedAt])
}

model FinanceOp {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         String // income | expense
  // income: advance | interim | final (поступления денег) ; extra_work | contract_change (изменение суммы договора)
  incomeType   String?
  // expense: materials | equipment | labor | other | <пользовательская>
  category     String?
  title        String
  qty          Decimal?  @db.Decimal(14, 4)
  unit         String?
  unitPrice    Decimal?  @db.Decimal(14, 2)
  amount       Decimal   @db.Decimal(14, 2) // начислено (для поступлений = получено)
  paidAmount   Decimal   @default(0) @db.Decimal(14, 2) // фактически оплачено (для расходов)
  counterparty String? // поставщик, арендодатель, рабочий
  date         DateTime  @default(now())
  note         String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, projectId, deletedAt])
}

model Note {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String
  body      String    @default("")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, deletedAt])
}

model Plan {
  code       String  @id
  title      String
  months     Int
  starsPrice Int
  rubPrice   Int     @default(0) // ориентировочная цена в рублях для показа
  aiLimit    Int     @default(0)
  active     Boolean @default(true)
  sort       Int     @default(0)
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode        String
  stars           Int
  provider        String   @default("stars") // stars | yookassa
  amountRub       Int?
  telegramChargeId String  @unique
  status          String   @default("paid") // paid | refunded
  createdAt       DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity    String
  entityId  String
  action    String
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, entity, entityId])
}
